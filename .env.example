# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.
# Semua variabel boleh dikosongkan saat npm run dev.

# Database online (Neon/Supabase). Kosongkan untuk memakai database lokal di folder .data
DATABASE_URL=

# Kunci rahasia untuk token sesi dan kode OTP. WAJIB diisi saat deploy (minimal 32 karakter acak).
RAHASIA_APLIKASI=

# Pengiriman email OTP lewat Gmail (pakai App Password, bukan kata sandi Gmail biasa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_PENGIRIM=

# Opsional: kirim kode OTP juga lewat WhatsApp memakai Fonnte (fonnte.com).
# Daftar, sambungkan nomor WhatsApp pengirim dengan scan QR, lalu salin token perangkatnya.
FONNTE_TOKEN=

# Alamat website untuk tautan di email, misal https://tuntasin.vercel.app
ALAMAT_SITUS=http://localhost:3000

# Tombol masuk sekali klik dan kotak Mode demo. Isi 0 untuk mematikannya (misal setelah lomba).
MODE_DEMO=1
